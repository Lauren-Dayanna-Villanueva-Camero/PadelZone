# Puerto del servidor
PORT=5000
# Cadena de conexión a MongoDB (obligatoria)
MONGODB_URI=mongodb://127.0.0.1:27017/padelzone
# Secreto para firmar los JWT (obligatorio)
JWT_SECRET=cambia_este_secreto
NODE_ENV=development
# URL del frontend (CORS)
CLIENT_URL=http://localhost:5173
# Cloudinary (opcional; si no se configura, las imágenes se guardan en MongoDB)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Correo de recuperación de contraseña con Gmail (opcional). Requiere verificación
# en 2 pasos y una "contraseña de aplicación": https://myaccount.google.com/apppasswords
# Sin estas variables, en desarrollo el enlace se muestra en consola y en la respuesta.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=PadelZone
# Inicio de sesión con Google (opcional): ID de cliente OAuth de Google Cloud Console.
# Debe ser el mismo que VITE_GOOGLE_CLIENT_ID en frontend/.env
GOOGLE_CLIENT_ID=
# Pagos en línea con Wompi (opcional): https://comercios.wompi.co → Desarrolladores.
# Con llaves de prueba (pub_test_...) se usa el sandbox. Sin estas variables los pagos
# en línea son simulados (tarjeta 4242 4242 4242 4242 aprueba, 4111 1111 1111 1111 rechaza).
# En el panel de Wompi pon como URL de eventos: <URL del backend>/api/pagos/wompi/eventos
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Multas por no asistir a una reserva que se iba a pagar en la sede (opcionales):
# porcentaje del precio de la reserva, inasistencias que hacen falta para que las
# reservas solo se puedan pagar en línea, y en cuántos días se cuentan
MULTA_PORCENTAJE=50
MULTA_LIMITE_INASISTENCIAS=2
MULTA_DIAS_HISTORIAL=180
