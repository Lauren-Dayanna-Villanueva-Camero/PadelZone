# Puerto del servidor
PORT=5000
# Cadena de conexión a MongoDB (obligatoria)
MONGODB_URI=mongodb://127.0.0.1:27017/padelzone
# Secreto para firmar los JWT (obligatorio)
JWT_SECRET=cambia_este_secreto
NODE_ENV=development
# URL del frontend (CORS)
CLIENT_URL=http://localhost:5173
# Cloudinary (opcional; si no se configura, las imágenes se guardan en MongoDB)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
